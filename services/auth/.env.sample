AUTH_SERVICE_PORT=8081
AUTH_DATABASE_URL=postgres://workshop:workshop@localhost:5432/auth?sslmode=disable

# JWT は RS256 (非対称鍵). 秘密鍵で署名し、公開鍵で検証する.
# パスは `make run` の実行ディレクトリ (services/auth) からの相対パス.
# 開発用の鍵は make keys でリポジトリ直下の keys/ に生成する (*.pem は git 管理外 / 本番では使用しないこと).
AUTH_JWT_PRIVATE_KEY_PATH=../../keys/jwt_dev_private.pem
AUTH_JWT_PUBLIC_KEY_PATH=../../keys/jwt_dev_public.pem
AUTH_JWT_TTL_SECONDS=3600
