FILES_SERVICE_PORT=8082
FILES_DATABASE_URL=postgres://workshop:workshop@localhost:5432/files?sslmode=disable

# JWT は RS256 (非対称鍵). Files は検証のみ行うため公開鍵のみを使う（秘密鍵は持たない）。
# パスは `make run` の実行ディレクトリ (services/files) からの相対パス。
# 開発用の鍵は auth と共通 (リポジトリ直下の make keys で生成、*.pem は git 管理外 / 本番では使用しないこと)。
FILES_JWT_PUBLIC_KEY_PATH=../../keys/jwt_dev_public.pem

# アップロードされたファイル本体を保存するローカルディレクトリ.
FILES_STORAGE_DIR=./data
