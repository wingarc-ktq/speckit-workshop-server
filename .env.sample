# ===== docker compose 共通 =====
POSTGRES_USER=workshop
POSTGRES_PASSWORD=workshop
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# JWT は RS256 (非対称鍵). 秘密鍵を持つのは Auth サービスだけで、
# Files サービスは公開鍵で検証のみ行う.
# 開発用の鍵ペアは make keys でリポジトリ直下の keys/ に生成する (*.pem は git 管理外 / 本番では使用しないこと).
# compose.yaml は keys/ を各コンテナの /keys にマウントする.

# サービスごとの設定は各 services/<name>/.env.sample を参照
